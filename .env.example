# Required for Questathon MCP requests
AQ_TOKEN=replace-with-your-questathon-personal-token

# Required by the protected /api/sync endpoint and npm run sync
SYNC_SECRET=replace-with-a-long-random-secret

# Optional: remote persistent storage. Without these, JSON files under data/ are used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: app URL used by npm run sync (defaults to http://localhost:3000)
# SYNC_BASE_URL=http://localhost:3000
